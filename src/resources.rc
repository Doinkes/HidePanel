#include <windows.h>
#include "resource.h"

// ---------------------------------------------------------------------------
//  Манифест (DPI-aware, asInvoker)
// ---------------------------------------------------------------------------
IDR_APP_MANIFEST RT_MANIFEST "src/HidePanel.manifest"

// ---------------------------------------------------------------------------
//  Иконка
// ---------------------------------------------------------------------------
IDI_APP_ICON ICON "assets/icon.ico"

// ---------------------------------------------------------------------------
//  Версия
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HidePanel"
            VALUE "FileDescription",  "HidePanel - instant taskbar auto-hide"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "HidePanel"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "HidePanel.exe"
            VALUE "ProductName",      "HidePanel"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
